<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TVSorter.Ui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TVSorter.Ui.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Page header ── -->
        <Border Grid.Row="0"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1A1A1A"/>
        </Border>

        <!-- ── Tab sections ── -->
        <TabControl Grid.Row="1" Margin="16,12">

            <!-- ════ Directories ════ -->
            <TabItem Header="Directories">
                <ScrollViewer Padding="4,8,4,4">
                    <StackPanel Spacing="16">

                        <!-- Source Directory card -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Source Directory"
                                           FontWeight="SemiBold"
                                           Foreground="#0078D4"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Settings.SourceDirectory}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Content="Browse…"
                                            Command="{Binding BrowseSourceDirectoryCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Destination Directories card -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Destination Directories"
                                           FontWeight="SemiBold"
                                           Foreground="#0078D4"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ListBox Grid.Column="0"
                                             Height="110"
                                             ItemsSource="{Binding DestinationDirectories}"
                                             SelectedItem="{Binding SelectedDestinationDirectory}"
                                             Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                        <Button Content="Add"
                                                Command="{Binding AddDestinationDirectoryCommand}"
                                                Width="80"/>
                                        <Button Content="Remove"
                                                Command="{Binding RemoveDestinationDirectoryCommand}"
                                                Width="80"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Default Destination"
                                               FontSize="12"
                                               Foreground="#555555"/>
                                    <ComboBox ItemsSource="{Binding DestinationDirectories}"
                                              SelectedItem="{Binding Settings.DefaultDestinationDirectory}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ignored Directories card -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Ignored Directories"
                                           FontWeight="SemiBold"
                                           Foreground="#0078D4"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ListBox Grid.Column="0"
                                             Height="110"
                                             ItemsSource="{Binding IgnoredDirectories}"
                                             SelectedItem="{Binding SelectedIgnoredDirectory}"
                                             Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                        <Button Content="Add"
                                                Command="{Binding AddIgnoredDirectoryCommand}"
                                                Width="80"/>
                                        <Button Content="Remove"
                                                Command="{Binding RemoveIgnoredDirectoryCommand}"
                                                Width="80"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════ File Options ════ -->
            <TabItem Header="File Options">
                <ScrollViewer Padding="4,8,4,4">
                    <StackPanel Spacing="16">

                        <!-- File Extensions card -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="File Extensions"
                                           FontWeight="SemiBold"
                                           Foreground="#0078D4"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ListBox Grid.Column="0"
                                             Height="110"
                                             ItemsSource="{Binding FileExtensions}"
                                             SelectedItem="{Binding SelectedFileExtension}"
                                             Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                        <Button Content="Add"
                                                Command="{Binding AddFileExtensionCommand}"
                                                Width="80"/>
                                        <Button Content="Remove"
                                                Command="{Binding RemoveFileExtensionCommand}"
                                                Width="80"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Output Format card -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Default Output Format"
                                           FontWeight="SemiBold"
                                           Foreground="#0078D4"/>
                                <TextBox Text="{Binding Settings.DefaultOutputFormat}"
                                         Watermark="{}{FName}\Season {SNum(1)}\{SName(.)}.S{SNum(2)}E{ENum(2)}.{EName(.)}{Ext}"/>
                                <TextBlock Text="Use format tokens like {FName}, {SNum}, {ENum}, {EName}, {Ext}."
                                           FontSize="11"
                                           Foreground="#888888"/>
                            </StackPanel>
                        </Border>

                        <!-- Overwrite Keywords card -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Overwrite Keywords"
                                           FontWeight="SemiBold"
                                           Foreground="#0078D4"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ListBox Grid.Column="0"
                                             Height="110"
                                             ItemsSource="{Binding OverwriteKeywords}"
                                             SelectedItem="{Binding SelectedOverwriteKeyword}"
                                             Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                        <Button Content="Add"
                                                Command="{Binding AddOverwriteKeywordCommand}"
                                                Width="80"/>
                                        <Button Content="Remove"
                                                Command="{Binding RemoveOverwriteKeywordCommand}"
                                                Width="80"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════ Regular Expressions ════ -->
            <TabItem Header="Regular Expressions">
                <ScrollViewer Padding="4,8,4,4">
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Regular Expressions"
                                       FontWeight="SemiBold"
                                       Foreground="#0078D4"/>
                            <TextBlock Text="Patterns used to match episode filenames."
                                       FontSize="11"
                                       Foreground="#888888"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <ListBox Grid.Column="0"
                                         Height="200"
                                         ItemsSource="{Binding RegularExpressions}"
                                         SelectedItem="{Binding SelectedRegularExpression}"
                                         Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                    <Button Content="Add"
                                            Command="{Binding AddRegularExpressionCommand}"
                                            Width="80"/>
                                    <Button Content="Remove"
                                            Command="{Binding RemoveRegularExpressionCommand}"
                                            Width="80"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ════ Behavior ════ -->
            <TabItem Header="Behavior">
                <ScrollViewer Padding="4,8,4,4">
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Behavior Options"
                                       FontWeight="SemiBold"
                                       Foreground="#0078D4"
                                       Margin="0,0,0,8"/>
                            <CheckBox Content="Recurse Subdirectories"
                                      IsChecked="{Binding Settings.RecurseSubdirectories}"
                                      Padding="4"/>
                            <CheckBox Content="Delete Empty Subdirectories"
                                      IsChecked="{Binding Settings.DeleteEmptySubdirectories}"
                                      Padding="4"/>
                            <CheckBox Content="Rename If Exists"
                                      IsChecked="{Binding Settings.RenameIfExists}"
                                      Padding="4"/>
                            <CheckBox Content="Add Unmatched Shows"
                                      IsChecked="{Binding Settings.AddUnmatchedShows}"
                                      Padding="4"/>
                            <CheckBox Content="Unlock Matched Shows"
                                      IsChecked="{Binding Settings.UnlockMatchedShows}"
                                      Padding="4"/>
                            <CheckBox Content="Lock Shows With No Episodes"
                                      IsChecked="{Binding Settings.LockShowsWithNoEpisodes}"
                                      Padding="4"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ── Sticky footer: Save / Revert ── -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Revert"
                        Command="{Binding RevertCommand}"
                        Width="100"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="100"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>