<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TVSorter.Ui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="TVSorter.Ui.Views.SplashScreenView"
        x:DataType="vm:SplashScreenViewModel"
        Title="TVSorter"
        Width="500"
        Height="300"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Icon="/Assets/tvsorter.ico">

	<Border Background="#F0F0F0"  
	        BorderThickness="2" 
	        CornerRadius="10"
	        BoxShadow="0 4 16 2 #40000000">
		<Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
			
			<!-- Logo Area -->
			<Border Grid.Row="0" 
			        Background="#F0F0F0" 
			        Padding="20,30"
			        CornerRadius="8,8,0,0">
				<StackPanel HorizontalAlignment="Center" Spacing="10">
					<!-- Grayscale Logo Image -->
					<Image Source="avares://TVSorter.Ui/Assets/logo-grayscale.png"
					       Width="400"
					       Height="80"
					       Stretch="Uniform"
					       HorizontalAlignment="Center"/>
					<TextBlock Text="Organize Your TV Shows" 
					           FontSize="14" 
					           Foreground="#666666"
					           HorizontalAlignment="Center"
					           Margin="0,10,0,0"/>
				</StackPanel>
			</Border>

			<!-- Main Content Area -->
			<StackPanel Grid.Row="1" 
			            Margin="40,30,40,10" 
			            VerticalAlignment="Center"
			            Spacing="15">
				
				<!-- Progress Text -->
				<TextBlock Text="{Binding ProgressText}" 
				           FontSize="14" 
				           HorizontalAlignment="Center"
				           Foreground="#333333"/>

				<!-- Progress Bar -->
				<ProgressBar Value="{Binding ProgressValue}" 
				             Maximum="100" 
				             Height="8"
				             CornerRadius="4"
				             Foreground="#0078D4"
				             Background="#E0E0E0"/>

				<!-- Progress Percentage -->
				<TextBlock Text="{Binding ProgressValue, StringFormat='{}{0}%'}" 
				           FontSize="12" 
				           HorizontalAlignment="Center"
				           Foreground="#666666"/>
			</StackPanel>

			<!-- Version Info -->
			<StackPanel Grid.Row="3" 
			            Margin="20,10" 
			            Spacing="5">
				<TextBlock Text="{Binding Version}" 
				           FontSize="12" 
				           HorizontalAlignment="Center"
				           Foreground="#666666"/>
				<TextBlock Text="{Binding Copyright}" 
				           FontSize="11" 
				           HorizontalAlignment="Center"
				           Foreground="#999999"/>
			</StackPanel>

			<!-- Bottom Spacer -->
			<Border Grid.Row="4" Height="10"/>

		</Grid>
	</Border>

</Window>
