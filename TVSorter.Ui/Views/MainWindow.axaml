<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:TVSorter.Ui.ViewModels"
		xmlns:controls="using:TVSorter.Ui.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TVSorter.Ui.Views.MainWindow"
		WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Title="{Binding Title}"
        Icon="/Assets/tvsorter.ico">
	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<!-- Menu Styling -->
		<Style Selector="Menu">
			<Setter Property="Background" Value="#F0F0F0"/>
		</Style>
		
		<Style Selector="MenuItem">
			<Setter Property="Foreground" Value="#333333"/>
		</Style>
		
		<Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="#E0E0E0"/>
		</Style>
		
		<Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="#D0D0D0"/>
		</Style>

		<!-- TabControl Styling -->
		<Style Selector="TabControl">
			<Setter Property="Background" Value="#FAFAFA"/>
			<Setter Property="Padding" Value="8,4,8,0"/>
		</Style>
		
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="16,8"/>
			<Setter Property="Foreground" Value="#666666"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0,0,4,0"/>
			<Setter Property="CornerRadius" Value="4,4,0,0"/>
		</Style>
		
		<Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#E8E8E8"/>
		</Style>
		
		<Style Selector="TabItem:pointerover">
			<Setter Property="Foreground" Value="#333333"/>
		</Style>
		
		<Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="White"/>
		</Style>
		
		<Style Selector="TabItem:selected">
			<Setter Property="Foreground" Value="#0078D4"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<!-- General Button Styling -->
		<Style Selector="Button">
			<Setter Property="Background" Value="#0078D4"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#0078D4"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="12,6"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		
		<Style Selector="Button:pointerover">
			<Setter Property="Background" Value="#005A9E"/>
			<Setter Property="BorderBrush" Value="#005A9E"/>
		</Style>
		
		<Style Selector="Button:pressed">
			<Setter Property="Background" Value="#004578"/>
			<Setter Property="BorderBrush" Value="#004578"/>
		</Style>
		
		<Style Selector="Button:disabled">
			<Setter Property="Background" Value="#CCCCCC"/>
			<Setter Property="BorderBrush" Value="#CCCCCC"/>
			<Setter Property="Foreground" Value="#999999"/>
		</Style>

		<!-- TextBox Styling -->
		<Style Selector="TextBox">
			<Setter Property="BorderBrush" Value="#CCCCCC"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#333333"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		
		<Style Selector="TextBox:focus">
			<Setter Property="BorderBrush" Value="#0078D4"/>
			<Setter Property="BorderThickness" Value="2"/>
		</Style>
		
		<Style Selector="TextBox:pointerover">
			<Setter Property="BorderBrush" Value="#999999"/>
		</Style>

		<!-- CheckBox Styling -->
		<Style Selector="CheckBox">
			<Setter Property="Foreground" Value="#333333"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>

		<!-- ProgressBar Styling -->
		<Style Selector="ProgressBar">
			<Setter Property="Foreground" Value="#0078D4"/>
			<Setter Property="Background" Value="#E0E0E0"/>
			<Setter Property="Height" Value="4"/>
			<Setter Property="CornerRadius" Value="2"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*,Auto">
		<!-- Menu Bar -->
		<Menu Grid.Row="0">
			<MenuItem Header="_File">
				<MenuItem Header="_Add Shows..." Command="{Binding AddShowsCommand}"/>
				<MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}"/>
				<Separator/>
				<MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
			</MenuItem>
			<MenuItem Header="_Help">
				<MenuItem Header="_Check for Updates..." Command="{Binding CheckForUpdatesCommand}"/>
				<Separator/>
				<MenuItem Header="_About..." Command="{Binding OpenAboutCommand}"/>
			</MenuItem>
		</Menu>

		<!-- Main Content Area -->
		<TabControl Grid.Row="1">
			<TabControl.Items>
				<TabItem Header="Sorting">
				</TabItem>
				<TabItem Header="Shows">
					<TabItem.ContentTemplate>
						<DataTemplate>
							<controls:ShowsView/>
						</DataTemplate>
					</TabItem.ContentTemplate>
				</TabItem>
				<TabItem Header="Logs"/>
			</TabControl.Items>
		</TabControl>

		<!-- Status Bar (placeholder for future use) -->
		<Border Grid.Row="2" 
		        Background="#F0F0F0" 
		        BorderBrush="#E0E0E0" 
		        BorderThickness="0,1,0,0" 
		        Padding="10,4"
		        Height="28">
			<TextBlock Text="Ready" 
			           FontSize="12" 
			           Foreground="#666666"
			           VerticalAlignment="Center"/>
		</Border>
	</Grid>
</Window>
